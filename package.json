{
  "name": "wargr.com",
  "version": "1.0.0",
  "private": true,
  "description": "wargr.com — Michael Wargr's essays. Angular 22 SSG on cx-framework (light theme), prerendered and served by Express on the Mac mini. Articles are pulled from ../ghostwriter (☑-marked files are published).",
  "author": "Michael Wargr <michael@wargr.com>",
  "license": "UNLICENSED",
  "homepage": "https://wargr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/wargr.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "images": "node scripts/prepare-article-images.mjs",
    "import": "pnpm run images && node scripts/import-articles.mjs",
    "dev": "pnpm run import && ng serve --configuration local --host 127.0.0.1 --port 4260",
    "build": "pnpm run import && ng build --configuration prod",
    "build:release": "ng build --configuration prod --output-path \"$SITE_RELEASE_DIR\"",
    "build:local": "pnpm run import && ng build --configuration local",
    "start": "node server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "compression": "^1.7.5",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "marked": "^15.0.6",
    "prettier": "^3.8.1",
    "sanitize-html": "^2.17.6",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mikaelcedergren/cx-framework",
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
