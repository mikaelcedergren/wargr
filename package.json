{
  "name": "wargr.com",
  "version": "1.0.0",
  "private": true,
  "description": "wargr.com — Michael Wargr's videos and essays. Angular 22 SSG on cx-framework (light theme), prerendered and served by Express on the Mac mini. Articles are authored in the private Admin and stored in data/wargr.db; the publisher regenerates the tracked snapshot from the published closure.",
  "author": "Michael Wargr <michael@wargr.com>",
  "license": "UNLICENSED",
  "homepage": "https://wargr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/wargr.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.5.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.5.0"
  },
  "scripts": {
    "images": "pnpm run generate:content",
    "generate:content": "bin/generate-content",
    "dev": "pnpm favicon:check && node scripts/dev.mjs",
    "dev:owner": "pnpm favicon:check && node scripts/dev.mjs --owner",
    "admin:password-hash": "node scripts/admin-password-hash.mjs",
    "build": "pnpm run build:browser && pnpm run build:server",
    "build:browser": "ng build --configuration prod",
    "build:server": "pnpm --dir server build",
    "build:server:release": "cx-server-artifact --package wargr-server",
    "build:release": "ng build --configuration prod --output-path \"$SITE_RELEASE_DIR\"",
    "build:local": "pnpm favicon:check && ng build --configuration local",
    "start": "pnpm run start:web",
    "start:web": "node server/dist/index.js",
    "start:worker": "node server/dist/worker.js",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:server",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "pnpm --dir server typecheck",
    "test": "pnpm run test:build && pnpm run test:server",
    "test:build": "node --test tests/build-contract.test.mjs tests/e2e-environment.test.mjs tests/generated-content-transaction.test.mjs tests/published-input-state.test.mjs tests/publish-lock.test.mjs tests/publish-contract.test.mjs tests/launchd-contract.test.mjs tests/snapshot-contract.test.mjs tests/dev-launcher.test.mjs",
    "test:server": "pnpm run build:server && pnpm --dir server test && node --test tests/server-contract.test.mjs",
    "test:verification": "node --test tests/change-verification.test.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "favicon:generate": "cx-development-favicon --apply",
    "favicon:check": "cx-development-favicon",
    "platform:check": "cx-platform-check --root .",
    "verify:change": "node scripts/verify-change.mjs",
    "style:check": "cx-style-token-check --all",
    "check": "pnpm format:check && pnpm favicon:check && pnpm platform:check && pnpm style:check && pnpm typecheck && pnpm test:verification && pnpm test && pnpm e2e:hmr && pnpm build",
    "e2e:hmr": "node scripts/run-hmr-e2e.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "ag-charts-community": "^13.3.1",
    "marked": "^18.0.7",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "1.62.0",
    "@types/node": "^26.0.0",
    "pnpm": "11.23.0",
    "prettier": "^3.9.6",
    "sanitize-html": "^2.17.6",
    "typescript": "~6.0.3"
  }
}
