{
  "name": "wargr.com",
  "version": "1.0.0",
  "private": true,
  "description": "wargr.com — Michael Wargr's essays. Angular 22 SSG on cx-framework (light theme), prerendered and served by Express on the Mac mini. Articles are pulled from ../ghostwriter (☑-marked files are published).",
  "author": "Michael Wargr <michael@wargr.com>",
  "license": "UNLICENSED",
  "homepage": "https://wargr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/wargr.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "import": "node scripts/import-articles.mjs",
    "dev": "node scripts/import-articles.mjs && ng serve --configuration local --host 127.0.0.1 --port 4260",
    "build": "node scripts/import-articles.mjs && ng build --configuration prod && node scripts/flatten.mjs",
    "build:local": "node scripts/import-articles.mjs && ng build --configuration local && node scripts/flatten.mjs",
    "start": "node server/index.mjs",
    "serve": "node server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/localize": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-server": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/ssr": "^22.0.3",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@playwright/test": "1.60.0",
    "marked": "^15.0.6",
    "prettier": "^3.8.1",
    "sanitize-html": "^2.17.5",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
