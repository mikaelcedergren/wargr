#!/bin/zsh
# Rebuild wargr.com from the ghostwriter essays. Triggered by launchd (com.wargr.sync) on changes to
# ../ghostwriter/wargr, plus a periodic safety poll. The shared release command builds away from
# the live output and atomically activates the completed release without a service restart.
#
# Guard: only rebuild when the PUBLISHED set or a canonical article image changed. The signature is
# over ☑-marked essays and article-images/*.png, so editing a draft never triggers a build.
set -eu
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# Resolve the repo from this script's own location and ghostwriter as its sibling, so the same
# script works on the production Mac mini and on a development mirror. cd-normalising keeps the
# signature paths identical to the previous hardcoded form on production.
REPO="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$(cd "$REPO/../ghostwriter/wargr" && pwd)"
IMAGES="$REPO/article-images"
STAMP="$REPO/.run/ghostwriter.stamp"
cd "$REPO"
# .run/ may not exist on a fresh checkout; without it the stamp write below fails after a
# successful build, and every later poll rebuilds again.
mkdir -p "$REPO/.run"

sig=$(
  {
    find "$SRC" -maxdepth 1 -name '☑*.md' -exec stat -f '%N %m %z' {} \; 2>/dev/null
    find "$IMAGES" -maxdepth 1 -name '*.png' -exec stat -f '%N %m %z' {} \; 2>/dev/null
  } | sort | shasum | awk '{print $1}'
)

if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$sig" ]]; then
  exit 0   # published set unchanged — nothing to do
fi

ts() { date -u +%FT%TZ }
echo "[$(ts)] published essays or article images changed — rebuilding wargr.com"
node "$REPO/../server-ops/bin/site-release.mjs" --site wargr --apply
echo "$sig" > "$STAMP"
echo "[$(ts)] wargr.com release built and activated"
