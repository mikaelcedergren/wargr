#!/bin/zsh
# Rebuild wargr.com from the ghostwriter essays. Triggered by launchd (com.wargr.sync) on changes to
# ../ghostwriter/wargr, plus a periodic safety poll. The shared release command builds away from
# the live output and atomically activates the completed release without a service restart.
#
# Guard: only rebuild when the published input closure changes. The content digest covers ☑ essays,
# their exact relevant Git history, and canonical article-image bytes; draft-only edits remain out.
# This entrypoint owns only root selection and the persistent command-form kernel lock. The locked
# worker owns the complete recover/generate/prove/commit/release transaction.
set -eu
umask 077
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# The immutable scheduled release sets all three roots explicitly. A deliberate manual checkout
# invocation retains the same sibling discovery without making the scheduled job trust mutable
# tool bytes from either Wargr or server-ops.
TOOL_REPO="${WARGR_PUBLISHER_TOOL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
REPO="${WARGR_REPO_ROOT:-$TOOL_REPO}"
GHOSTWRITER_ROOT="${WARGR_GHOSTWRITER_ROOT:-$(cd "$REPO/../ghostwriter" && pwd)}"
OPS_TOOL_ROOT="${WARGR_SERVER_OPS_TOOL_ROOT:-$(cd "$REPO/../server-ops" && pwd)}"
export WARGR_PUBLISHER_TOOL_ROOT="$TOOL_REPO"
export WARGR_REPO_ROOT="$REPO"
export WARGR_GHOSTWRITER_ROOT="$GHOSTWRITER_ROOT"
export WARGR_SERVER_OPS_TOOL_ROOT="$OPS_TOOL_ROOT"
LOCK="$REPO/.run/ghostwriter-sync.lock"
LOCKED_TRANSACTION="$TOOL_REPO/bin/sync-from-ghostwriter-transaction"
cd "$REPO"
# .run/ may not exist on a fresh checkout; without it the stamp write below fails after a
# successful build, and every later poll rebuilds again.
if [[ ! -e "$REPO/.run" ]]; then
  mkdir -m 700 "$REPO/.run"
elif [[ ! -d "$REPO/.run" || -L "$REPO/.run" ]]; then
  echo "Wargr runtime root is unsafe: $REPO/.run" >&2
  exit 70
fi

# launchd serialises a job's own invocations, but this kernel-owned lock also makes manual and
# scheduled runs mutually exclusive. Command form keeps lockf alive around the complete worker; -k
# preserves one inode forever, and the kernel drops the lock after a whole-process crash.
exec /usr/bin/lockf -t 0 -k "$LOCK" /bin/zsh "$LOCKED_TRANSACTION"
