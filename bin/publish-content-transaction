#!/bin/zsh
# Internal locked worker for bin/publish-content. Invoke only through that command-form
# kernel-lock owner so manual and scheduled generated-output transactions remain mutually exclusive.
set -eu
umask 077
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
NODE=/opt/homebrew/bin/node

if (( $# != 0 )); then
  echo "publish-content-transaction accepts no arguments" >&2
  exit 64
fi

TOOL_REPO="${WARGR_PUBLISHER_TOOL_ROOT:?WARGR_PUBLISHER_TOOL_ROOT is required}"
REPO="${WARGR_REPO_ROOT:?WARGR_REPO_ROOT is required}"
DB_PATH="${WARGR_DB_PATH:?WARGR_DB_PATH is required}"
OPS_TOOL_ROOT="${WARGR_SERVER_OPS_TOOL_ROOT:?WARGR_SERVER_OPS_TOOL_ROOT is required}"
ALLOWLIST="$TOOL_REPO/scripts/wargr-generated-source.json"
SOURCE_ATTESTATION="$REPO/.run/generated-source.json"
INPUT_STATE="$TOOL_REPO/scripts/published-input-state.mjs"
CONTENT_TRANSACTION="$TOOL_REPO/scripts/generated-content-transaction.mjs"
SOURCE_GUARD="$OPS_TOOL_ROOT/bin/generated-source-guard.mjs"
SITE_RELEASE="$OPS_TOOL_ROOT/bin/site-release.mjs"
cd "$REPO"

cleanup_transaction() {
  status=$?
  trap - EXIT
  if ! WARGR_REPO_ROOT="$REPO" \
    WARGR_PUBLISHER_TOOL_ROOT="$TOOL_REPO" \
    WARGR_DB_PATH="$DB_PATH" \
    WARGR_SERVER_OPS_TOOL_ROOT="$OPS_TOOL_ROOT" \
      "$NODE" "$CONTENT_TRANSACTION" recover; then
    echo "generated-content recovery failed; exact source state needs review" >&2
    status=70
  fi
  exit "$status"
}
trap cleanup_transaction EXIT

WARGR_REPO_ROOT="$REPO" \
WARGR_PUBLISHER_TOOL_ROOT="$TOOL_REPO" \
WARGR_DB_PATH="$DB_PATH" \
  "$NODE" "$CONTENT_TRANSACTION" recover

input_before="$("$NODE" "$INPUT_STATE" capture)"
if "$NODE" "$INPUT_STATE" matches "$input_before"; then
  exit 0 # published closure unchanged — nothing to do
fi

ts() { date -u +%FT%TZ }
echo "[$(ts)] published essays or article images changed — rebuilding wargr.com"
baseline_state=$(
  "$NODE" "$SOURCE_GUARD" \
    --repo "$REPO" \
    --baseline "$ALLOWLIST" \
    --attestation "$SOURCE_ATTESTATION" \
    --clean-head-policy wargr-browser-presentation
)
pre_revision="${baseline_state%% *}"
pre_fingerprint="${baseline_state#* }"
if [[ -z "$pre_revision" || -z "$pre_fingerprint" || "$pre_revision" == "$pre_fingerprint" ]]; then
  echo "generated-source guard returned an invalid baseline state" >&2
  exit 65
fi
WARGR_REPO_ROOT="$REPO" \
WARGR_PUBLISHER_TOOL_ROOT="$TOOL_REPO" \
WARGR_DB_PATH="$DB_PATH" \
  "$NODE" "$CONTENT_TRANSACTION" generate --defer-attestation
input_after="$("$NODE" "$INPUT_STATE" capture)"
if [[ "$input_after" != "$input_before" ]]; then
  echo "publication inputs changed during generation; publication was refused" >&2
  exit 75
fi
generated_state=$(
  "$NODE" "$SOURCE_GUARD" \
    --repo "$REPO" \
    --capture "$ALLOWLIST" \
    --expected-revision "$pre_revision"
)
generated_revision="${generated_state%% *}"
expected_fingerprint="${generated_state#* }"
if [[ "$generated_revision" != "$pre_revision" || -z "$expected_fingerprint" ]]; then
  echo "generated-source guard returned an invalid post-generation state" >&2
  exit 65
fi
# Authorization and attestation are the transaction's commit boundary. A failure before this
# command restores both every generated output and the exact previous attestation; a crash after
# the durable commit leaves a source/attestation pair that the next retry can prove.
WARGR_REPO_ROOT="$REPO" \
WARGR_PUBLISHER_TOOL_ROOT="$TOOL_REPO" \
WARGR_SERVER_OPS_TOOL_ROOT="$OPS_TOOL_ROOT" \
  "$NODE" "$CONTENT_TRANSACTION" commit \
  --revision "$generated_revision" \
  --fingerprint "$expected_fingerprint"
CX_DEVELOPMENT_ROOT="$(cd "$REPO/.." && pwd)" "$NODE" "$SITE_RELEASE" \
  --site wargr \
  --browser-only \
  --expected-source-fingerprint "$expected_fingerprint" \
  --apply
"$NODE" "$INPUT_STATE" record "$input_after"
echo "[$(ts)] wargr.com release built and activated"
