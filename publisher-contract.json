{
  "schemaVersion": 1,
  "kind": "wargr-scheduled-publisher",
  "publisher": "wargr",
  "repository": "wargr",
  "entrypoint": "bin/publish-content",
  "sourceFiles": [
    "bin/publish-content",
    "bin/publish-content-transaction",
    "scripts/article-slugs.mjs",
    "scripts/generate-articles.mjs",
    "scripts/generated-content-transaction.mjs",
    "scripts/prepare-article-images.mjs",
    "scripts/published-input-state.mjs",
    "scripts/wargr-generated-source.json"
  ],
  "inputs": {
    "database": "wargr/data/wargr.db",
    "images": "wargr/article-images"
  },
  "logs": {
    "stdout": "wargr/.run/publish.out.log",
    "stderr": "wargr/.run/publish.err.log"
  }
}
