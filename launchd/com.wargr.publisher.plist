<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.wargr.publisher</string>

    <key>UserName</key>
    <string>cortex</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>ProgramArguments</key>
    <array>
      <string>__NODE_BINARY__</string>
      <string>__WARGR_PUBLISHER_RELEASE__/server-ops/bin/scheduled-publisher-launcher.mjs</string>
      <string>--digest</string>
      <string>__WARGR_PUBLISHER_DIGEST__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WARGR_WORKING_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key><string>/Users/cortex</string>
      <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>CX_DEVELOPMENT_ROOT</key><string>__CX_DEVELOPMENT_ROOT__</string>
    </dict>

    <!-- Fire instantly when the article database or canonical article images change… -->
    <key>WatchPaths</key>
    <array>
      <string>__WARGR_WATCH_DATABASE__</string>
      <string>__WARGR_WATCH_IMAGES__</string>
    </array>
    <!-- …and poll hourly as a safety net. The signature guard makes a no-change run a cheap
         no-op; only the published closure and canonical PNG masters affect it, so draft edits,
         polish rounds and session writes never trigger a rebuild. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>

    <key>SoftResourceLimits</key>
    <dict><key>NumberOfFiles</key><integer>8192</integer></dict>
    <key>HardResourceLimits</key>
    <dict><key>NumberOfFiles</key><integer>16384</integer></dict>

    <key>StandardOutPath</key>
    <string>__WARGR_PUBLISH_STDOUT__</string>

    <key>StandardErrorPath</key>
    <string>__WARGR_PUBLISH_STDERR__</string>
  </dict>
</plist>
