<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.wargr.sync</string>

    <key>UserName</key>
    <string>cortex</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/cortex/Development/wargr/bin/sync-from-ghostwriter</string>
    </array>

    <!-- Fire instantly when essays or canonical article images change… -->
    <key>WatchPaths</key>
    <array>
      <string>/Users/cortex/Development/ghostwriter/wargr</string>
      <string>/Users/cortex/Development/wargr/article-images</string>
    </array>
    <!-- …and poll hourly as a safety net for in-place edits. The signature guard makes a
         no-change run a cheap no-op; only ☑ essays and canonical PNG masters affect it. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/cortex/Development/wargr/.run/sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cortex/Development/wargr/.run/sync.err.log</string>
  </dict>
</plist>
