# Web role only. Copy to .env.web with mode 600. The worker never reads this file.

# The Studio owner username.
WARGR_STUDIO_USERNAME=

# Never put the plaintext Studio password here. Generate its scrypt hash with
# `pnpm studio:password-hash`, then paste the complete `scrypt$...` output below.
WARGR_STUDIO_PASSWORD_HASH=

# At least 32 random characters. Signs Studio session cookies.
WARGR_STUDIO_SESSION_SECRET=
