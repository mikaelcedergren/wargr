# Web role only. Copy to .env.web with mode 600. The worker never reads this file.

# The Admin owner username.
WARGR_STUDIO_USERNAME=admin

# Never put the plaintext Admin password here. Generate its scrypt hash with
# `pnpm admin:password-hash`, then paste the complete `scrypt$...` output below.
WARGR_STUDIO_PASSWORD_HASH=

# At least 32 random characters. Signs Admin session cookies.
WARGR_STUDIO_SESSION_SECRET=
